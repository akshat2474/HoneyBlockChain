{
  "name": "honeyblockchain-backend",
  "version": "1.0.0",
  "description": "HoneyBlockChain unified backend - API, Blockchain, WhatsApp",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "lint": "eslint src/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "express-rate-limit": "^7.4.0",
    "axios": "^1.7.0",
    "ioredis": "^5.4.0",
    "ethers": "^6.13.0",
    "zod": "^3.23.0",
    "dotenv": "^16.4.0",
    "sharp": "^0.33.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "pino-http": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
