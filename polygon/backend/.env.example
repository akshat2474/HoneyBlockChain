# Polygon / Web3
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY
PRIVATE_KEY=your_admin_wallet_private_key_without_0x
CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS

# Pinata / IPFS
PINATA_JWT=your_pinata_jwt
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# PostgreSQL
DATABASE_URL=postgresql://honeychain:honeychain@localhost:5432/honeychain

# JWT Auth
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# QR Signing
QR_HMAC_SECRET=change_this_to_a_different_long_random_secret

# MQTT Broker (Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883

# App
BACKEND_BASE_URL=http://localhost:8000
